{
  "name": "mnist_quick",
  "out_dir": "out",
  "dtype": "f32",
  "seeds": [
    67
  ],
  "data": {
    "task": "classification",
    "train": {
      "x": "data/train-images.idx3-ubyte",
      "y": "data/train-labels.idx1-ubyte"
    },
    "test": {
      "x": "data/t10k-images.idx3-ubyte",
      "y": "data/t10k-labels.idx1-ubyte"
    },
    "normalize": "min_max",
    "first_label": 0,
    "label_column": "last",
    "validation": 0.1,
    "split_seed": 0
  },
  "net": {
    "hidden": [
      64
    ],
    "bias": true,
    "activation": "relu",
    "head": "softmax_cross_entropy"
  },
  "train": {
    "epochs": 50,
    "batch": 64,
    "lr": 0.1,
    "log_every": 10
  },
  "output": {
    "weights_every": 0,
    "grid_steps": 200
  }
}