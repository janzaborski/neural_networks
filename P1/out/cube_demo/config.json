{
  "name": "cube_demo",
  "out_dir": "out",
  "dtype": "f64",
  "seeds": [
    42
  ],
  "data": {
    "task": "regression",
    "train": "data/projekt1/regression/data.cube.train.100.csv",
    "test": "data/projekt1/regression/data.cube.test.100.csv",
    "normalize": "per_column",
    "label_column": "last",
    "validation": 0.2,
    "split_seed": 0
  },
  "net": {
    "hidden": [
      16,
      16
    ],
    "bias": true,
    "activation": "tanh",
    "head": "identity_mse"
  },
  "train": {
    "epochs": 1000,
    "batch": 16,
    "lr": 0.01,
    "log_every": 10
  },
  "output": {
    "weights_every": 0,
    "grid_steps": 200
  }
}